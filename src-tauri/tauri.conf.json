{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CHDK SD Creator",
  "version": "0.1.0",
  "identifier": "app.chdk.sdcreator",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CHDK SD Creator",
        "width": 920,
        "height": 680,
        "minWidth": 760,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
